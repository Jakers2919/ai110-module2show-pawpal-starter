
classDiagram
    class Owner {
        +str name
        +list pets
        +add_pet(pet)
        +get_all_tasks()
    }

    class Pet {
        +str name
        +str species
        +list tasks
        +add_task(task)
        +get_tasks()
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str scheduled_time
        +str frequency
        +bool completed
        +date due_date
        +mark_complete()
    }

    class Scheduler {
        +int available_minutes
        +list skipped_tasks
        +list conflicts
        +generate_daily_plan(owner)
        +sort_by_time(tasks)
        +filter_tasks(tasks)
        +detect_conflicts(tasks)
        +handle_recurring_tasks(owner)
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Scheduler ..> Owner : reads pets and tasks
    Scheduler ..> Task : organizes
